<configuration status="all">
    <Properties>
        <Property name="layout">%d [%t] %-5level %logger - %m%n</Property>
    </Properties>
    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="${layout}"/>
        </Console>
        <File name="LogFile" fileName="C:\Users\Administrator\Desktop\test\app.log">
            <PatternLayout>
                <Pattern>%d %p %c{1.} [%t] %m%n</Pattern>
            </PatternLayout>
        </File>
    </Appenders>
    <Loggers>
        <Logger name="ControlPlansStart" level="trace" additivity="true">
            <AppenderRef ref="LogFile" />
            <AppenderRef reg="Console" />
        </Logger>
        <Root level="trace">
            <AppenderRef ref="LogFile"/>
        </Root>
    </Loggers>
</configuration>